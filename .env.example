# 本地开发与测试配置文件（复制本文件为 .env 并填入实际值）
# .env 已被 .gitignore 忽略，不会提交到代码仓库
#
# 规则说明：
# 脚本中的 MOCK_CONFIG 若包含敏感字段，可使用类似 "__VARIABLE_NAME__"（双下划线包裹）作为占位符。
# 本地运行时，TaskContext 会自动识别该格式，去除双下划线并从本 .env 文件中读取同名变量进行替换。
# 例如：MOCK_CONFIG 中的 "__TRAKT_CLIENT_ID__" 会自动读取下方配置的 TRAKT_CLIENT_ID

# HTTP 代理（可选，支持用户名密码认证）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://username:password@127.0.0.1:7890

# Trakt (https://trakt.tv)
# 创建应用后填入 TRAKT_CLIENT_ID，运行 `python tools/trakt_auth.py` 完成授权并自动填充
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=
TRAKT_REFRESH_TOKEN=

# B站动态 Cookie
BILIBILI_COOKIE=

# IMDb Cookie（用于排除已标记为 watched 的电影）
IMDB_COOKIE=
